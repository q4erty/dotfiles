{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 0,
    "exclusive": true,
    "fixed-center": true,
    "gtk-layer-shell": true,
    "passthrough": false,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["memory", "cpu", "battery", "network"],

    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by-number": true,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "persistent-workspaces": {
            "*": 6
        }
    },

    "clock": {
        "format": "{:%a %d/%m/%Y %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-click-right": "mode"
        }
    },

    "memory": {
        "interval": 5,
        "format": "▮ {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G",
        "on-click": "kitty --title btop sh -c 'btop || htop'"
    },

    "cpu": {
        "interval": 3,
        "format": "♥ {usage}%",
        "tooltip-format": "{avg_frequency} GHz  |  Load: {load}",
        "on-click": "kitty --title btop sh -c 'btop || htop'"
    },

    "battery": {
        "interval": 30,
        "format": "⚡ {capacity}%",
        "format-charging": "⚡ {capacity}% ↑",
        "format-plugged": "⚡ {capacity}%",
        "format-full": "⚡ full",
        "tooltip-format": "{timeTo}  |  {power:.1f}W",
        "states": {
            "warning": 25,
            "critical": 10
        }
    },

    "network": {
        "interval": 5,
        "format-wifi": "@ {signalStrength}%",
        "format-ethernet": "@ eth",
        "format-disconnected": "@ --",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)  |  ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}  |  ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "on-click": "kitty --title nmtui sh -c 'nmtui'"
    }
}
